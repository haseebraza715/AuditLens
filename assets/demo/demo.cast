[44.394058, "o", "{\r\n  \"summary\": {\r\n    \"total_issues\": 2,\r\n    \"high_severity\": 2,\r\n    \"medium_severity\": 0,\r\n    \"low_severity\": 0\r\n  },\r\n  \"dataset_info\": {\r\n    \"rows\": 8,\r\n    \"columns\": 4,\r\n    \"target_column\": \"target\",\r\n    \"sensitive_columns\": [\r\n      \"group\",\r\n      \"sex\"\r\n    ]\r\n  },\r\n  \"issues\": [\r\n    {\r\n      \"issue_id\": \"correlation_sex_target\",\r\n      \"type\": \"sensitive_correlation\",\r\n      \"description\": \"Correlation score between sensitive column 'sex' and target 'target' is 0.500\",\r\n      \"affected_column\": \"sex\",\r\n      \"severity\": \"high\",\r\n      \"metrics\": {\r\n        \"sensitive_column\": \"sex\",\r\n        \"target_column\": \"target\",\r\n        \"method\": \"point_biserial\",\r\n        \"correlation_value\": 0.4999999999999999,\r\n        \"absolute_correlation\": 0.4999999999999999,\r\n        \"sample_size\": 8\r\n      },\r\n      \"justification\": \"point_biserial=0.5000 exceeds high threshold 0.3000\"\r\n    },\r\n    {\r\n      \"issue_id\": \"demographic_parity_sex_target\",\r\n      \"type\": \"demographic_parity_gap\",\r\n      \"description"]
[44.394249, "o", "\": \"Demographic parity gap for 'sex' is 0.500 for target 'target'\",\r\n      \"affected_column\": \"sex\",\r\n      \"severity\": \"high\",\r\n      \"metrics\": {\r\n        \"sensitive_column\": \"sex\",\r\n        \"target_column\": \"target\",\r\n        \"positive_class\": \"1\",\r\n        \"positive_rates\": {\r\n          \"F\": 0.25,\r\n          \"M\": 0.75\r\n        },\r\n        \"demographic_parity_gap\": 0.5,\r\n        \"highest_positive_rate_group\": \"M\",\r\n        \"lowest_positive_rate_group\": \"F\",\r\n        \"sample_size\": 8,\r\n        \"group_sizes\": {\r\n          \"F\": 4,\r\n          \"M\": 4\r\n        }\r\n      },\r\n      \"justification\": \"demographic_parity_gap=0.5000 exceeds high threshold 0.1500\"\r\n    }\r\n  ]\r\n}\r\n"]
