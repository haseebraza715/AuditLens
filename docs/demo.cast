[3.531, "o", "\r\n\r\n\u001b[1m==========================================================================\u001b[0m\r\n\u001b[1mSTEP 2  \u00b7  Run Layer 1 statistical audit\u001b[0m\r\n\u001b[1m==========================================================================\u001b[0m\r\n  Checks applied:\r\n    \u2022 class distribution / imbalance\r\n    \u2022 differential missingness by group\r\n    \u2022 sensitive-column \u2194 target correlation\r\n    \u2022 subgroup label distribution (demographic parity)\r\n"]
